{
  "name": "pi-chrome-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local bridge service connecting Chrome extension to pi coding agent",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "kill": "fuser -k 18731/tcp 2>/dev/null; fuser -k 18732/tcp 2>/dev/null; echo 'Bridge killed'",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "typebox": "^1.1.0",
    "uuid": "^9.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
